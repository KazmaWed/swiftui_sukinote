{
  "type": "object",
  "properties": {
    "notes": {
      "type": "array",
      "items": { "$ref": "#/$defs/note" }
    }
  },
  "required": ["notes"],
  "additionalProperties": false,
  "$defs": {
    "note": {
      "type": "object",
      "properties": {
        "category": {
          "type": "string",
          "enum": ["like", "dislike", "hobby", "anniversary", "family", "school", "work"]
        },
        "title": {
          "type": "string",
          "description": "The specific item itself (e.g. 和食), not a label for the kind of item (e.g. 好きな食べ物)"
        },
        "content": {
          "type": "string",
          "description": "One or two sentences about the item, including related general statements from the chat"
        },
        "date": {
          "anyOf": [
            { "$ref": "#/$defs/partialDate" },
            { "type": "null" }
          ]
        },
        "isAnnual": { "type": "boolean" }
      },
      "required": ["category", "title", "content", "date", "isAnnual"],
      "additionalProperties": false
    },
    "partialDate": {
      "type": "object",
      "properties": {
        "year": { "type": ["integer", "null"] },
        "month": { "type": ["integer", "null"] },
        "day": { "type": ["integer", "null"] }
      },
      "required": ["year", "month", "day"],
      "additionalProperties": false
    }
  }
}
